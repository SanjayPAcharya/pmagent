# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Claude Code: keep machine-specific settings local, but share the role launchers
# (.claude/commands/pmagent-*.md) that start each pipeline session.
.claude/*
!.claude/commands/

# Env files — defense in depth (sourcecode/.gitignore also covers these).
# Only the committed *.example files are tracked.
.env
.env.*
!.env.example
!.env.prod.example

# Logs / temp
*.log
